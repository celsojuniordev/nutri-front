# URL base da API do backend (nutri-back).
VITE_API_BASE_URL=http://localhost:8080

# Client ID do Google Cloud Console usado pelo Google Identity Services no cliente.
# IMPORTANTE: deve ser o mesmo Client ID configurado como GOOGLE_CLIENT_ID no backend
# (nutri-back) neste ambiente — caso contrário todo login via Google falha com
# GOOGLE_TOKEN_INVALID (ver design.md - "Integração com Google Identity Services").
VITE_GOOGLE_CLIENT_ID=
